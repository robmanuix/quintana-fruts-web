# Zoho SMTP credentials used by src/pages/api/contact.ts to send the
# Contacto form submissions. ZOHO_SMTP_PASS must be a Zoho App Password
# (Zoho Mail -> Settings -> Security -> App Passwords), not the account login.
ZOHO_SMTP_USER=info@quintanafruts.com
ZOHO_SMTP_PASS=
CONTACT_TO_EMAIL=info@quintanafruts.com
