# Postgres connection string. For local dev this matches docker-compose.yml's
# "postgres" service (see repo root).
DATABASE_URI=postgres://payload:payload@localhost:5432/quintana_fruts_cms

# Long random value, generated once per environment — never reuse across envs.
PAYLOAD_SECRET=

# Public URL this app is reachable at (used to build absolute admin/API links).
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# S3-compatible media storage. In local dev these point at the "minio" service
# from docker-compose.yml; in production they point at the real Cloudflare R2
# bucket. If S3_BUCKET is unset, the S3 storage plugin is skipped and Payload
# falls back to no upload storage configured (uploads will fail until set).
S3_BUCKET=quintana-fruts-media
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/quintana-fruts-media

# Astro production domain, comma-separated if more than one — scopes the
# Payload admin panel's own browser->API calls. Does not affect Astro's
# server-to-server build-time fetch (CORS is a browser-only mechanism).
CORS_ALLOWLIST=http://localhost:4321,https://quintanafruts.com

# Coolify per-resource deploy-webhook for the Astro app, used by
# src/hooks/triggerRebuild.ts to redeploy the site after publishing.
COOLIFY_WEB_DEPLOY_WEBHOOK_URL=
COOLIFY_DEPLOY_WEBHOOK_TOKEN=
REBUILD_DEBOUNCE_MS=15000
