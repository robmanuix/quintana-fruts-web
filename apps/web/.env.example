# Zoho SMTP credentials used by src/pages/api/contact.ts to send the
# Contacto form submissions. ZOHO_SMTP_PASS must be a Zoho App Password
# (Zoho Mail -> Settings -> Security -> App Passwords), not the account login.
ZOHO_SMTP_USER=info@quintanafruts.com
ZOHO_SMTP_PASS=
CONTACT_TO_EMAIL=info@quintanafruts.com

# Payload CMS — build-time only, never shipped client-side (Astro fully
# prerenders). PAYLOAD_API_KEY belongs to the "Astro build" service account
# created by apps/cms's seed script (npm run seed).
# PAYLOAD_SERVER_URL is the origin only (no /api) — media URLs returned by
# Payload's REST API are relative (e.g. /api/media/file/x.png, proxied
# through Payload itself rather than served directly from S3/R2), so this is
# also what astro.config.mjs's image.remotePatterns needs to allow.
PAYLOAD_SERVER_URL=http://localhost:3000
PAYLOAD_REST_URL=http://localhost:3000/api
PAYLOAD_API_KEY=
