---
import { Image } from "astro:assets";
import DividerLeaf from "../assets/icons/divider-leaf.svg";
import ArrowIcon from "../assets/icons/arrow.svg";
import { getRelativeLocaleUrl } from "astro:i18n";
import { contactHref, getHomePage, mediaUrl } from "../lib/payload";

const locale = Astro.currentLocale === "en" ? "en" : "es";
const homePage = await getHomePage(locale);
const hero = homePage.hero;
const ctaHref = contactHref(locale, getRelativeLocaleUrl(locale, "/contacto"), hero.ctaReason);

const columns = hero.backgroundImages ?? [];
const byColumn = (key: string) => columns.find((c) => c.columnKey === key);
const purple = byColumn("purple");
const tamarillo = byColumn("tamarillo");
const granadilla = byColumn("granadilla");
---

<section class="hero" id="inicio">
	<div class="hero__bg">
		{
			purple && (
				<div class="hero__photo-wrap" data-fruit="purple" style={`--zoom: ${purple.zoom ?? 1}; --pan-y: ${purple.panY ?? 0}%;`}>
					<Image src={mediaUrl(purple.image)!} alt="" class="hero__photo" width={1000} height={1000} widths={[600, 1000]} sizes="33vw" loading="eager" />
				</div>
			)
		}
		{
			tamarillo && (
				<div class="hero__photo-wrap" data-fruit="tamarillo" style={`--zoom: ${tamarillo.zoom ?? 1}; --pan-y: ${tamarillo.panY ?? 0}%;`}>
					<Image src={mediaUrl(tamarillo.image)!} alt="" class="hero__photo" width={1000} height={1000} widths={[600, 1000]} sizes="33vw" loading="eager" />
				</div>
			)
		}
		{
			granadilla && (
				<div class="hero__photo-wrap" data-fruit="granadilla" style={`--zoom: ${granadilla.zoom ?? 1}; --pan-y: ${granadilla.panY ?? 0}%;`}>
					<Image
						src={mediaUrl(granadilla.image)!}
						alt=""
						class="hero__photo hero__photo--granadilla"
						width={1000}
						height={1000}
						widths={[600, 1000]}
						sizes="33vw"
						loading="eager"
					/>
				</div>
			)
		}
		<div class="hero__overlay" aria-hidden="true"></div>
	</div>

	<div class="hero__content">
		<h1 class="hero__title" data-animate="hero-title">
			{hero.titleLine1}<br />
			{hero.titleLine2Prefix}<span class="hero__title-accent">{hero.titleAccent}</span>
		</h1>
		<p class="hero__subtitle" data-animate="hero-subtitle">
			{hero.subtitleLine1}<br class="hero__subtitle-break" /> {hero.subtitleLine2}
		</p>
		<img src={DividerLeaf.src} alt="" class="hero__divider" width="457" height="38" />
		<a href={ctaHref} class="btn btn--primary" data-animate="hero-cta">
			{hero.ctaLabel}
			<img src={ArrowIcon.src} alt="" width="18" height="15" class="hero__cta-arrow" />
		</a>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 780px;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		background: var(--color-cream);
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		display: flex;
	}

	.hero__bg :global(.hero__photo-wrap) {
		position: relative;
		flex: 1 1 33.33%;
		height: 100%;
		width: 100%;
		overflow: hidden;
	}

	.hero__bg :global(.hero__photo) {
		position: absolute;
		top: var(--pan-y, 0%);
		left: 50%;
		width: calc(var(--zoom, 1) * 100%);
		height: calc(var(--zoom, 1) * 100%);
		max-width: none;
		object-fit: cover;
		transform: translateX(-50%);
	}

	/* shows the paired granadillas instead of the centered single fruit */
	.hero__bg :global(.hero__photo--granadilla) {
		left: -85%;
		transform: none;
	}

	.hero__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			#272b2cf2 0%,
			#272b2cb3 14%,
			#272b2c00 26% 44%,
			#272b2c80 51.2%,
			#272b2cbf 59%,
			#272b2cf7 78.3% 100%
		);
	}

	.hero__content {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1090px;
		margin-inline: auto;
		padding-bottom: 50px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
		text-align: center;
	}

	.hero__title {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(36px, 6.6vw, 96px);
		line-height: 1.05;
		color: var(--color-cream);
		white-space: normal;
	}

	.hero__title-accent {
		color: var(--color-orange);
	}

	.hero__subtitle {
		margin: 0;
		font-family: var(--font-body);
		font-size: clamp(14px, 2vw, 24px);
		letter-spacing: 4px;
		text-transform: uppercase;
		color: var(--color-cream-soft);
	}

	.hero__subtitle-break {
		display: none;
	}

	.hero__divider {
		width: min(457px, 80%);
		height: auto;
	}

	.hero__cta-arrow {
		transform: rotate(90deg);
	}

	.hero__content .btn--primary {
		padding: 11px 26px;
		gap: 14px;
		font-size: 14px;
		letter-spacing: 2.6px;
	}

	/*
		Mobile: full-screen auto-advancing slideshow (pure CSS crossfade, no JS)
		instead of the desktop's side-by-side strips — one photo fills the whole
		viewport height at a time, exactly like desktop's overlay+text treatment.
	*/
	@keyframes heroSlideFade {
		0%,
		4% {
			opacity: 0;
		}
		11%,
		30% {
			opacity: 1;
		}
		37%,
		100% {
			opacity: 0;
		}
	}

	@media (max-width: 640px) {
		.hero {
			min-height: 100dvh;
			background: var(--color-hero-overlay);
		}

		.hero__bg :global(.hero__photo-wrap) {
			position: absolute;
			inset: 0;
			flex: none;
			width: 100%;
			opacity: 0;
			animation: heroSlideFade 9s ease-in-out infinite;
		}

		.hero__photo-wrap[data-fruit="purple"] {
			animation-delay: 0s;
		}

		.hero__photo-wrap[data-fruit="tamarillo"] {
			animation-delay: 3s;
		}

		.hero__photo-wrap[data-fruit="granadilla"] {
			animation-delay: 6s;
		}

		.hero__content {
			padding: 0 24px 44px;
			gap: 14px;
		}

		.hero__title {
			font-size: clamp(24px, 7.5vw, 30px);
		}

		.hero__subtitle {
			font-size: 13px;
			letter-spacing: 3px;
		}

		.hero__subtitle-break {
			display: inline;
		}

		.hero__content .btn--primary {
			padding: 10px 22px;
			gap: 12px;
			font-size: 12px;
			letter-spacing: 2px;
		}

		.hero__cta-arrow {
			width: 14px;
			height: 12px;
		}
	}

	@media (max-width: 640px) and (prefers-reduced-motion: reduce) {
		.hero__bg :global(.hero__photo-wrap) {
			animation: none;
			opacity: 0;
		}

		.hero__photo-wrap[data-fruit="purple"] {
			opacity: 1;
		}
	}

	@media (min-width: 768px) {
		.hero {
			min-height: 900px;
		}
	}
</style>

<script>
	import { gsap } from "gsap";

	function waitForImage(img: HTMLImageElement | null, timeout = 800): Promise<void> {
		if (!img || img.complete) return Promise.resolve();
		return new Promise((resolve) => {
			const done = () => resolve();
			img.addEventListener("load", done, { once: true });
			img.addEventListener("error", done, { once: true });
			setTimeout(done, timeout);
		});
	}

	async function initHeroEntrance() {
		const hero = document.querySelector<HTMLElement>(".hero");
		if (!hero) return;

		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		const isMobile = window.matchMedia("(max-width: 640px)").matches;

		const purpleWrap = document.querySelector<HTMLElement>('.hero__photo-wrap[data-fruit="purple"]');
		const tamarilloWrap = document.querySelector<HTMLElement>('.hero__photo-wrap[data-fruit="tamarillo"]');
		const granadillaWrap = document.querySelector<HTMLElement>('.hero__photo-wrap[data-fruit="granadilla"]');
		const overlay = document.querySelector<HTMLElement>(".hero__overlay");
		const headerLogo = document.querySelector<HTMLElement>(".site-header__logo");
		const headerActions = document.querySelector<HTMLElement>(".site-header__actions");
		const title = document.querySelector<HTMLElement>(".hero__title");
		const subtitle = document.querySelector<HTMLElement>(".hero__subtitle");
		const divider = document.querySelector<HTMLElement>(".hero__divider");
		const cta = document.querySelector<HTMLElement>(".hero__content .btn--primary");

		const copyEls = [title, subtitle, divider, cta].filter((el): el is HTMLElement => Boolean(el));
		const headerEls = [headerLogo, headerActions].filter((el): el is HTMLElement => Boolean(el));

		// wait for the three columns to be decoded so the staircase never rises on a blank frame
		if (!isMobile) {
			await Promise.all(
				[purpleWrap, tamarilloWrap, granadillaWrap].map((wrap) => waitForImage(wrap?.querySelector("img") ?? null)),
			);
		}

		const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

		if (!isMobile && purpleWrap && tamarilloWrap && granadillaWrap) {
			gsap.set([purpleWrap, tamarilloWrap, granadillaWrap], { yPercent: 100, opacity: 0 });

			// phase 1-2: staircase — each column rises into place in sequence, left to right
			tl.to(purpleWrap, { yPercent: 0, opacity: 1, duration: 0.55 })
				.to(tamarilloWrap, { yPercent: 0, opacity: 1, duration: 0.55 }, "-=0.35")
				.to(granadillaWrap, { yPercent: 0, opacity: 1, duration: 0.55 }, "-=0.35");
		}

		// phase 3a: shadow overlay, fade-in-down
		if (overlay) {
			gsap.set(overlay, { opacity: 0, y: -20 });
			tl.to(overlay, { opacity: 1, y: 0, duration: 0.4 }, isMobile ? 0.35 : "-=0.15");
		}

		// phase 3b: header logo + menu/lang icons
		if (headerEls.length) {
			gsap.set(headerEls, { opacity: 0, y: -10 });
			tl.to(headerEls, { opacity: 1, y: 0, duration: 0.4 }, "-=0.2");
		}

		// phase 4: copy, staggered fade-in
		if (copyEls.length) {
			gsap.set(copyEls, { opacity: 0, y: 15 });
			tl.to(copyEls, { opacity: 1, y: 0, duration: 0.4, stagger: 0.08 }, "-=0.1");
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHeroEntrance);
	} else {
		initHeroEntrance();
	}
</script>
