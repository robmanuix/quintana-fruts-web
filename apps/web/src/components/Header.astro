---
import { getRelativeLocaleUrl } from "astro:i18n";
import GlobeIcon from "../assets/icons/globe.svg";
import GlobeIconDark from "../assets/icons/globe-dark.svg";
import { getSiteSettings, mediaUrl } from "../lib/payload";

interface Props {
	/** "on-dark": cream/white elements over a photo hero (default). "on-light": dark elements for pages with a light/cream background. */
	variant?: "on-dark" | "on-light";
}

const { variant = "on-dark" } = Astro.props;

const locale = Astro.currentLocale === "en" ? "en" : "es";
const otherLocale = locale === "es" ? "en" : "es";
const settings = await getSiteSettings(locale);

const home = getRelativeLocaleUrl(locale, "/");
const navLinks = [
	{ href: `${home}#nosotros`, label: settings.header.navNosotros },
	{ href: `${home}#por-que-elegirnos`, label: settings.header.navPorQueElegirnos },
	{ href: `${home}#productos`, label: settings.header.navProductos },
	{ href: getRelativeLocaleUrl(locale, "/contacto"), label: settings.header.navContacto },
];

// swap to the equivalent page in the other language, preserving the current path
const unprefixedPath = locale === "en" ? Astro.url.pathname.replace(/^\/en\/?/, "/") : Astro.url.pathname;
const langSwitchHref = getRelativeLocaleUrl(otherLocale, unprefixedPath);

const logo = variant === "on-light" ? mediaUrl(settings.brand?.logoOnLight) : mediaUrl(settings.brand?.logoOnDark);
const globe = variant === "on-light" ? GlobeIconDark : GlobeIcon;
---

<header class="site-header" data-theme={variant}>
	<div class="site-header__inner">
		<a href={home} class="site-header__logo" aria-label={settings.header.logoAlt}>
			<img src={logo} alt="Quintana Früts" width="200" height="88" />
		</a>

		<div class="site-header__nav-collapse" data-nav-collapse>
			<nav class="site-header__nav" id="site-nav" aria-label={settings.header.ariaMainNav}>
				{
					navLinks.map((link) => (
						<a href={link.href} class="site-header__nav-link">
							{link.label}
						</a>
					))
				}
			</nav>
		</div>

		<div class="site-header__actions">
			<button
				type="button"
				class="site-header__menu-toggle"
				aria-label={settings.header.ariaOpenMenu}
				aria-expanded="false"
				aria-controls="site-nav"
				data-label-open={settings.header.ariaOpenMenu}
				data-label-close={settings.header.ariaCloseMenu}
			>
				<span class="site-header__menu-icon" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
			</button>

			<a href={langSwitchHref} class="site-header__lang">
				<img src={globe.src} alt="" width="20" height="20" />
				<span>{otherLocale.toUpperCase()}</span>
			</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		inset-inline: 0;
		top: 0;
		z-index: 20;
		background: transparent;
		backdrop-filter: none;
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0);
		transition: background-color 0.35s ease, backdrop-filter 0.35s ease, box-shadow 0.35s ease;
	}

	/* transparent overlay at the top (unchanged look); once the page scrolls, the
	   fixed header needs a backing so it stays legible over whatever content is
	   now underneath it — a frosted "glass" panel keeps that consistent regardless
	   of the section scrolling past. Tinted per theme so contrast holds either way. */
	.site-header.is-scrolled {
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		box-shadow: 0 4px 24px rgba(0, 0, 0, 0.12);
	}

	.site-header[data-theme="on-dark"].is-scrolled {
		background: rgba(39, 43, 44, 0.75);
	}

	.site-header[data-theme="on-light"].is-scrolled {
		background: rgba(243, 232, 209, 0.85);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		gap: 24px;
		padding: 24px var(--container-padding);
		transition: padding-block 0.35s ease;
	}

	.site-header.is-scrolled .site-header__inner {
		padding-block: 12px;
	}

	.site-header__logo {
		margin-right: auto;
	}

	.site-header__logo img {
		display: block;
		height: 70px;
		width: auto;
		transition: height 0.35s ease;
	}

	.site-header.is-scrolled .site-header__logo img {
		height: 48px;
	}

	.site-header__actions {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	/* grid-template-columns 0fr -> 1fr smoothly animates to the nav's natural width
	   without knowing it ahead of time; minmax(0, …fr) is what lets the track shrink
	   past the content's own min-width instead of being clamped to it */
	.site-header__nav-collapse {
		display: grid;
		grid-template-columns: minmax(0, 0fr);
		transition: grid-template-columns 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.site-header__nav-collapse.is-open {
		grid-template-columns: minmax(0, 1fr);
	}

	.site-header__nav {
		display: flex;
		align-items: center;
		gap: 32px;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		opacity: 0;
		transform: translateX(28px);
		transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.site-header__nav-collapse.is-open .site-header__nav {
		opacity: 1;
		transform: translateX(0);
		transition-delay: 0.08s;
	}

	.site-header__nav-link {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 16px;
		color: var(--color-cream);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.site-header__nav-link:hover,
	.site-header__nav-link:focus-visible {
		color: var(--color-orange);
	}

	.site-header__menu-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px;
	}

	.site-header__menu-icon {
		position: relative;
		display: inline-block;
		width: 24px;
		height: 19px;
		flex-shrink: 0;
	}

	.site-header__menu-icon span {
		position: absolute;
		left: 0;
		width: 100%;
		height: 3px;
		border-radius: 2px;
		background: var(--color-cream-soft);
		transition: top 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
	}

	.site-header__menu-icon span:nth-child(1) {
		top: 0;
	}

	.site-header__menu-icon span:nth-child(2) {
		top: 8px;
	}

	.site-header__menu-icon span:nth-child(3) {
		top: 16px;
	}

	/* hamburger -> X: the outer two lines meet at center and rotate into an X,
	   the middle line fades out */
	.site-header__menu-toggle[aria-expanded="true"] .site-header__menu-icon span:nth-child(1) {
		top: 8px;
		transform: rotate(45deg);
	}

	.site-header__menu-toggle[aria-expanded="true"] .site-header__menu-icon span:nth-child(2) {
		opacity: 0;
	}

	.site-header__menu-toggle[aria-expanded="true"] .site-header__menu-icon span:nth-child(3) {
		top: 8px;
		transform: rotate(-45deg);
	}

	.site-header__lang {
		display: flex;
		align-items: center;
		gap: 8px;
		padding-left: 24px;
		border-left: 1px solid rgba(255, 255, 255, 0.5);
		color: var(--color-cream-soft);
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 18px;
		text-decoration: none;
	}

	/* on-light: dark elements for pages with a light/cream background (e.g. Contacto) */
	.site-header[data-theme="on-light"] .site-header__nav-link {
		color: var(--color-black);
	}

	.site-header[data-theme="on-light"] .site-header__menu-icon span {
		background: var(--color-black);
	}

	.site-header[data-theme="on-light"] .site-header__lang {
		color: var(--color-black);
		border-left-color: rgba(25, 25, 23, 0.35);
	}

	/* below 640px there's no room for 4 links beside the icon on one line, so the
	   toggle/lang stay put next to the logo and the nav drops into a full-width panel
	   anchored under the header (same header, not a separate page overlay) — the
	   reveal direction switches from a horizontal slide to a vertical one to match */
	@media (max-width: 640px) {
		.site-header__nav-collapse {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: minmax(0, 0fr);
			background: #272b2c;
			transition: grid-template-rows 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		}

		/* fully opaque dark panel regardless of page theme, so the toggle stays legible
		   against it — white text with orange hover, for the strongest contrast.
		   The [data-theme] attribute selector matches either variant and outweighs
		   the on-light override's specificity (which would otherwise win). */
		.site-header[data-theme] .site-header__nav-collapse .site-header__nav-link {
			color: #ffffff;
		}

		.site-header[data-theme] .site-header__nav-collapse .site-header__nav-link:hover,
		.site-header[data-theme] .site-header__nav-collapse .site-header__nav-link:focus-visible {
			color: var(--color-orange);
		}

		.site-header__nav-collapse.is-open {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: minmax(0, 1fr);
		}

		.site-header__nav {
			flex-direction: column;
			align-items: flex-start;
			min-height: 0;
			gap: 20px;
			padding: 24px var(--container-padding);
			transform: translateY(-12px);
		}

		.site-header__nav-collapse.is-open .site-header__nav {
			transform: translateY(0);
		}

		.site-header__nav-link {
			font-size: 16px;
		}

		.site-header__lang span {
			display: none;
		}
	}
</style>

<script>
	function initMenuToggle() {
		const toggle = document.querySelector<HTMLButtonElement>(".site-header__menu-toggle");
		const collapse = document.querySelector<HTMLElement>("[data-nav-collapse]");
		if (!toggle || !collapse) return;

		const setOpen = (open: boolean) => {
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? toggle.dataset.labelClose ?? "" : toggle.dataset.labelOpen ?? "");
			collapse.classList.toggle("is-open", open);
		};

		toggle.addEventListener("click", () => {
			setOpen(toggle.getAttribute("aria-expanded") !== "true");
		});

		collapse.querySelectorAll<HTMLAnchorElement>(".site-header__nav-link").forEach((link) => {
			link.addEventListener("click", () => setOpen(false));
		});
	}

	function initScrollGlass() {
		const header = document.querySelector<HTMLElement>(".site-header");
		if (!header) return;

		const SCROLL_THRESHOLD = 10;
		let ticking = false;

		const update = () => {
			header.classList.toggle("is-scrolled", window.scrollY > SCROLL_THRESHOLD);
			ticking = false;
		};

		update();
		window.addEventListener(
			"scroll",
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(update);
			},
			{ passive: true },
		);
	}

	function initHeader() {
		initMenuToggle();
		initScrollGlass();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initHeader);
	} else {
		initHeader();
	}
</script>
