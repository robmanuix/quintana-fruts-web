---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ContactoIntro from "../components/ContactoIntro.astro";
import Footer from "../components/Footer.astro";
import { getContactPage } from "../lib/payload";

const locale = Astro.currentLocale === "en" ? "en" : "es";
const t = await getContactPage(locale);
---

<Layout title={t.seo?.pageTitle ?? undefined} description={t.seo?.pageDescription ?? undefined}>
	<Header variant="on-light" />
	<main>
		<ContactoIntro />
	</main>
	<Footer />
</Layout>
