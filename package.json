{
  "name": "quintana-fruts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @quintana-fruts/web",
    "dev:cms": "npm run dev -w @quintana-fruts/cms",
    "build:web": "npm run build -w @quintana-fruts/web",
    "build:cms": "npm run build -w @quintana-fruts/cms",
    "generate:types": "npm run generate:types -w @quintana-fruts/cms",
    "seed": "npm run seed -w @quintana-fruts/cms"
  }
}
