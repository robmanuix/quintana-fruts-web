---
import { Image } from "astro:assets";
import p1Main from "../assets/images/productos-1-main.png";
import p1Top from "../assets/images/productos-1-top.png";
import p1Bottom from "../assets/images/productos-1-bottom.png";
import p1Bloom from "../assets/images/productos-1-bloom.png";
import p2Main from "../assets/images/productos-2-main.png";
import p2Top from "../assets/images/productos-2-top.png";
import p2Bottom from "../assets/images/productos-2-bottom.png";
import p2Bloom from "../assets/images/productos-2-bloom.png";
import p3Main from "../assets/images/productos-3-main.png";
import p3Top from "../assets/images/productos-3-top.png";
import p3Bottom from "../assets/images/productos-3-bottom.png";
import p3Bloom from "../assets/images/flor-naranjilla.png";

import dividerLeafPurple from "../assets/icons/divider-leaf-purple.svg";
import dividerDashSmall from "../assets/icons/divider-dash-small.svg";
import dividerVertical from "../assets/icons/divider-vertical.svg";
import iconCtaDocument from "../assets/icons/icon-cta-document.svg";

import iconArrowPurple from "../assets/icons/icon-cta-arrow-purple.svg";
import iconArrowOrange from "../assets/icons/icon-cta-arrow-orange.svg";
import iconArrowGreen from "../assets/icons/icon-cta-arrow-green.svg";

import iconOrigenPurple from "../assets/icons/icon-stat-origen-purple.svg";
import iconSaborPurple from "../assets/icons/icon-stat-sabor-purple.svg";
import iconTemporadaPurple from "../assets/icons/icon-stat-temporada-purple.svg";
import iconTransportePurple from "../assets/icons/icon-stat-transporte-purple.svg";

import iconOrigenOrange from "../assets/icons/icon-stat-origen-orange.svg";
import iconSaborOrange from "../assets/icons/icon-stat-sabor-orange.svg";
import iconTemporadaOrange from "../assets/icons/icon-stat-temporada-orange.svg";
import iconTransporteOrange from "../assets/icons/icon-stat-transporte-orange.svg";

import iconOrigenGreen from "../assets/icons/icon-stat-origen-green.svg";
import iconSaborGreen from "../assets/icons/icon-stat-sabor-green.svg";
import iconTemporadaGreen from "../assets/icons/icon-stat-temporada-green.svg";
import iconTransporteGreen from "../assets/icons/icon-stat-transporte-green.svg";

import iconQuality from "../assets/icons/icon-productos-quality.svg";
import iconTrace from "../assets/icons/icon-productos-trace.svg";
import iconLogistics from "../assets/icons/icon-productos-logistics.svg";
import iconPartnership from "../assets/icons/icon-productos-partnership.svg";
import iconCalendar from "../assets/icons/icon-productos-calendar.svg";

const products = [
	{
		accent: "purple",
		name: "Gulupa",
		scientific: "Passiflora edulis",
		description:
			"Fruta de corteza púrpura y pulpa aromática con un balance agridulce perfecto. Fuente natural de antioxidantes y vitamina C que contribuye al bienestar diario.",
		photos: { main: p1Main, top: p1Top, bottom: p1Bottom },
		bloom: p1Bloom,
		bloomStyle: "corner",
		arrow: iconArrowPurple,
		stats: [
			{ icon: iconOrigenPurple, label: "Origen", value: "Ecuador" },
			{ icon: iconSaborPurple, label: "Sabor", value: "Agridulce" },
			{ icon: iconTemporadaPurple, label: "Temporada", value: "Todo el año" },
			{ icon: iconTransportePurple, label: "Transporte", value: "Aéreo" },
		],
	},
	{
		accent: "orange",
		name: "Granadilla",
		scientific: "Passiflora ligularis",
		description:
			"Fruto de cáscara dorada con pulpa transparente y sumamente dulce. Destaca por su alto contenido de fibra y agua, siendo excelente para la digestión y el cuidado estomacal.",
		photos: { main: p2Main, top: p2Top, bottom: p2Bottom },
		bloom: p2Bloom,
		bloomStyle: "corner",
		arrow: iconArrowOrange,
		stats: [
			{ icon: iconOrigenOrange, label: "Origen", value: "Ecuador" },
			{ icon: iconSaborOrange, label: "Sabor", value: "Dulce" },
			{ icon: iconTemporadaOrange, label: "Temporada", value: "Todo el año" },
			{ icon: iconTransporteOrange, label: "Transporte", value: "Aéreo" },
		],
	},
	{
		accent: "green",
		name: "Naranjilla",
		scientific: "Solanum quitoense",
		description:
			"Fruto tropical de corteza naranja y pulpa densa, con un excelente aporte de vitamina A y C. Ideal para fortalecer el sistema inmune.",
		photos: { main: p3Main, top: p3Top, bottom: p3Bottom },
		bloom: p3Bloom,
		bloomStyle: "corner",
		arrow: iconArrowGreen,
		stats: [
			{ icon: iconOrigenGreen, label: "Origen", value: "Ecuador" },
			{ icon: iconSaborGreen, label: "Sabor", value: "Ácido - Dulce" },
			{ icon: iconTemporadaGreen, label: "Temporada", value: "Todo el año" },
			{ icon: iconTransporteGreen, label: "Transporte", value: "Aéreo" },
		],
	},
];

const trustStats = [
	{ icon: iconQuality, title: ["Calidad", "excepcional"], desc: ["Seleccionamos frutas exóticas con los más", "altos estándares"] },
	{ icon: iconTrace, title: ["Trazabilidad", "completa"], desc: ["Controlamos cada etapa para garantizar", "transparencia y origen confiable."] },
	{ icon: iconLogistics, title: ["Logística", "confiable"], desc: ["Coordinamos envíos internacionales", "seguros y eficientes."] },
	{ icon: iconPartnership, title: ["Relaciones", "duraderas"], desc: ["Construimos alianzas basadas en", "confianza y compromiso."] },
	{ icon: iconCalendar, title: ["Disponibilidad", "todo el año"], desc: ["Suministro constante para acompañar", "tu demanda."] },
];
---

<section class="productos" id="productos">
	<div class="productos__inner">
		<div class="productos__intro">
			<h2 class="productos__heading">Frutas de Ecuador seleccionadas para el mundo.</h2>
			<img src={dividerLeafPurple.src} alt="" class="productos__divider" width="457" height="38" />
			<p class="productos__subheading">Cálidad superior, trazabilidad y relaciones que perduran.</p>
		</div>

		<div class="productos__list">
			{
				products.map((product) => (
					<article class:list={["productos__card", `productos__card--${product.accent}`]} data-product-card>
						<div class={`productos__card-bloom productos__card-bloom--${product.bloomStyle}`} aria-hidden="true">
							<Image src={product.bloom} alt="" widths={[400, 700]} sizes="600px" />
						</div>

						<div class="productos__card-photos">
							<div class="productos__photo productos__photo--main">
								<Image src={product.photos.main} alt={`${product.name} en su cultivo`} widths={[300, 500, 790]} sizes="(max-width: 1024px) 55vw, 395px" />
							</div>
							<div class="productos__photo-stack">
								<div class="productos__photo productos__photo--top">
									<Image src={product.photos.top} alt={`${product.name} cortada`} widths={[200, 384]} sizes="192px" />
								</div>
								<div class="productos__photo productos__photo--bottom">
									<Image src={product.photos.bottom} alt={`Planta de ${product.name}`} widths={[200, 384]} sizes="192px" />
								</div>
							</div>
						</div>

						<div class="productos__card-content">
							<div class="productos__card-heading">
								<p class="productos__card-name">{product.name}</p>
								<p class="productos__card-scientific">{product.scientific}</p>
							</div>
							<p class="productos__card-desc">{product.description}</p>
							<img src={dividerDashSmall.src} alt="" class="productos__card-dash" width="50" height="1" />
							<div class="productos__card-stats">
								{product.stats.map((stat) => (
									<div class="productos__stat">
										<img src={stat.icon.src} alt="" class="productos__stat-icon" width="36" height="36" />
										<div class="productos__stat-text">
											<span class="productos__stat-label">{stat.label}</span>
											<span class="productos__stat-value">{stat.value}</span>
										</div>
									</div>
								))}
							</div>
							<div class="productos__card-cta">
								<a href="#" class="productos__cta productos__cta--solid">
									Ficha técnica
									<img src={iconCtaDocument.src} alt="" width="16" height="20" />
								</a>
								<a
									href={`/contacto?asunto=${encodeURIComponent("Cotización de productos")}`}
									class="productos__cta productos__cta--outline"
								>
									Solicitar cotización
									<img src={product.arrow.src} alt="" width="17.5" height="15" class="productos__cta-arrow" />
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>

		<div class="productos__trust">
			{
				trustStats.map((stat, i) => (
					<>
						{i > 0 && <img src={dividerVertical.src} alt="" class="productos__trust-divider" aria-hidden="true" />}
						<div class="productos__trust-item">
							<img src={stat.icon.src} alt="" class="productos__trust-icon" width="53" height="53" />
							<p class="productos__trust-title">
								{stat.title.map((line) => (
									<>
										{line}
										<br />
									</>
								))}
							</p>
							<p class="productos__trust-desc">
								{stat.desc.map((line) => (
									<>
										{line}
										<br />
									</>
								))}
							</p>
						</div>
					</>
				))
			}
		</div>
	</div>
</section>

<style>
	.productos {
		position: relative;
		background: var(--color-cream);
		padding-block: 96px;
		overflow: hidden;
	}

	.productos__inner {
		max-width: 1272px;
		margin-inline: auto;
		padding-inline: 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.productos__intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		max-width: 750px;
		text-align: center;
	}

	.productos__heading {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: clamp(32px, 3.6vw, 54px);
		line-height: 1.2;
		color: var(--color-purple);
	}

	.productos__divider {
		width: min(457px, 80%);
		height: auto;
	}

	.productos__subheading {
		margin: 0;
		font-family: var(--font-nav);
		font-weight: 500;
		font-size: 18px;
		line-height: 32px;
		color: var(--color-black);
	}

	.productos__list {
		display: flex;
		flex-direction: column;
		gap: 24px;
		width: 100%;
		margin-top: 56px;
	}

	.productos__card {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 64px;
		width: 100%;
		padding: 12px;
		border-radius: 12px;
		background: rgba(249, 249, 249, 0.75);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
		overflow: hidden;
		transform-origin: 50% 50%;
		will-change: transform;
	}

	.productos__card-bloom {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
	}

	.productos__card-bloom :global(img) {
		display: block;
	}

	.productos__card-bloom--corner {
		overflow: hidden;
	}

	.productos__card-bloom--corner :global(img) {
		position: absolute;
		right: -4%;
		bottom: -6%;
		width: 26%;
		height: auto;
	}

	.productos__card-photos {
		position: relative;
		z-index: 1;
		display: flex;
		gap: 13px;
		flex-shrink: 0;
	}

	.productos__photo {
		border-radius: 8px;
		overflow: hidden;
	}

	.productos__photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.productos__photo--main {
		width: 395px;
		height: 410px;
	}

	.productos__photo-stack {
		display: flex;
		flex-direction: column;
		gap: 13px;
		width: 192px;
		flex-shrink: 0;
	}

	.productos__photo--top {
		width: 192px;
		height: 173px;
	}

	.productos__photo--bottom {
		width: 192px;
		height: 224px;
	}

	.productos__card-content {
		position: relative;
		z-index: 1;
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding-block: 18px;
	}

	.productos__card-heading {
		display: flex;
		flex-direction: column;
	}

	.productos__card-name {
		margin: 0;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 48px;
		line-height: 1;
		text-transform: uppercase;
	}

	.productos__card-scientific {
		margin: 0;
		font-family: var(--font-body);
		font-style: italic;
		font-weight: 400;
		font-size: 24px;
	}

	.productos__card-desc {
		margin: 0;
		max-width: 460px;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 14px;
		line-height: 1.6;
		color: var(--color-black);
	}

	.productos__card-dash {
		display: block;
	}

	.productos__card-stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(140px, 183px));
		gap: 10px 24px;
	}

	.productos__stat {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.productos__stat-icon {
		flex-shrink: 0;
		border-radius: 50%;
	}

	.productos__stat-text {
		display: flex;
		flex-direction: column;
	}

	.productos__stat-label {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 14px;
		color: var(--color-black);
	}

	.productos__stat-value {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 14px;
		color: var(--color-black);
	}

	.productos__card-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.productos__cta {
		display: inline-flex;
		align-items: center;
		gap: 20px;
		padding: 12px 24px;
		border-radius: var(--radius-pill);
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 14px;
		letter-spacing: 2.8px;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 0.2s ease;
	}

	.productos__cta:hover {
		transform: translateY(-2px);
	}

	.productos__cta--solid {
		display: none;
		color: var(--color-cream);
	}

	.productos__cta--outline {
		background: rgba(243, 232, 209, 0.24);
		backdrop-filter: blur(4px);
		border: 1px solid transparent;
		color: var(--color-black);
	}

	.productos__cta-arrow {
		transform: rotate(90deg);
	}

	.productos__card--purple .productos__card-heading {
		color: var(--color-purple);
	}

	.productos__card--purple .productos__cta--solid {
		background: var(--color-purple);
	}

	.productos__card--purple .productos__cta--outline {
		border-color: rgba(74, 37, 101, 0.24);
	}

	.productos__card--orange .productos__card-heading {
		color: var(--color-orange);
	}

	.productos__card--orange .productos__cta--solid {
		background: var(--color-orange);
	}

	.productos__card--orange .productos__cta--outline {
		border-color: rgba(240, 129, 32, 0.24);
	}

	.productos__card--orange .productos__photo--main :global(img) {
		object-position: center 75%;
	}

	.productos__card--purple .productos__photo--top,
	.productos__card--orange .productos__photo--top {
		background: #fff;
	}

	.productos__card--purple .productos__photo--top :global(img),
	.productos__card--orange .productos__photo--top :global(img) {
		object-fit: none;
		object-position: center;
	}

	.productos__card--green .productos__card-heading {
		color: var(--color-green);
	}

	.productos__card--green .productos__cta--solid {
		background: var(--color-green);
	}

	.productos__card--green .productos__cta--outline {
		border-color: rgba(129, 146, 39, 0.24);
	}

	.productos__trust {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		width: 100%;
		margin-top: 40px;
		padding: 24px;
		border: 1px solid rgba(25, 25, 23, 0.12);
		border-radius: 18px;
	}

	.productos__trust-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		flex: 1;
		min-width: 0;
		text-align: center;
	}

	.productos__trust-icon {
		object-fit: contain;
	}

	.productos__trust-title {
		margin: 0;
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 18px;
		line-height: 1.3;
		color: var(--color-purple);
	}

	.productos__trust-desc {
		margin: 0;
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 14px;
		line-height: 1.4;
		color: var(--color-black);
	}

	.productos__trust-divider {
		width: 1px;
		height: 100px;
		flex-shrink: 0;
	}

	@media (max-width: 1024px) {
		.productos__card {
			flex-direction: column;
			gap: 24px;
		}

		.productos__card-photos {
			width: 100%;
		}

		.productos__photo--main {
			flex: 1;
			width: auto;
			min-width: 0;
		}

		.productos__trust {
			flex-wrap: wrap;
			justify-content: center;
		}

		.productos__trust-item {
			flex: 1 1 calc(33.33% - 16px);
		}

		.productos__trust-divider {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.productos {
			padding-block: 64px;
		}

		.productos__heading {
			font-size: 32px;
		}

		.productos__list {
			margin-top: 40px;
		}

		.productos__card {
			padding: 16px;
		}

		.productos__card-photos {
			flex-wrap: wrap;
		}

		.productos__photo--main {
			flex-basis: 100%;
			height: 260px;
		}

		.productos__photo-stack {
			flex-direction: row;
			width: 100%;
		}

		.productos__photo--top,
		.productos__photo--bottom {
			flex: 1;
			width: auto;
			min-width: 0;
			height: 173px;
		}

		.productos__card-content {
			align-items: center;
			text-align: center;
		}

		.productos__card-heading {
			align-items: center;
		}

		.productos__card-name {
			font-size: 36px;
		}

		.productos__card-stats {
			grid-template-columns: repeat(2, 1fr);
			text-align: left;
		}

		.productos__card-cta {
			flex-direction: column;
			width: 100%;
		}

		.productos__cta {
			width: 100%;
			justify-content: center;
		}

		.productos__trust {
			gap: 32px;
		}

		.productos__trust-item {
			flex: 1 1 100%;
		}
	}
</style>

<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	function initIntroReveal() {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		const intro = document.querySelector<HTMLElement>(".productos__intro");
		if (!intro) return;

		const heading = intro.querySelector<HTMLElement>(".productos__heading");
		const divider = intro.querySelector<HTMLElement>(".productos__divider");
		const subheading = intro.querySelector<HTMLElement>(".productos__subheading");

		gsap.set(heading, { opacity: 0, y: 36 });
		gsap.set(divider, { opacity: 0, y: 20 });
		gsap.set(subheading, { opacity: 0, y: 20 });

		const tl = gsap.timeline({
			// toggleActions, not once:true — see initCardsReveal for why (crashes GSAP
			// when several once:true triggers are already past-due on a deep-scrolled load).
			scrollTrigger: { trigger: intro, start: "top 75%", toggleActions: "play none none none" },
		});

		if (heading) tl.to(heading, { opacity: 1, y: 0, duration: 0.65, ease: "power4.out" }, 0);
		if (divider) tl.to(divider, { opacity: 1, y: 0, duration: 0.5, ease: "power4.out" }, 0.2);
		if (subheading) tl.to(subheading, { opacity: 1, y: 0, duration: 0.5, ease: "power4.out" }, 0.32);
	}

	function initCardsReveal() {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		const cards = document.querySelectorAll<HTMLElement>("[data-product-card]");
		if (!cards.length) return;

		cards.forEach((card) => {
			gsap.fromTo(
				card,
				{ opacity: 0, y: 28, scale: 0.96 },
				{
					opacity: 1,
					y: 0,
					scale: 1,
					duration: 0.7,
					ease: "power3.out",
					// toggleActions, not once:true — see initIntroReveal above for why.
					scrollTrigger: { trigger: card, start: "top 85%", toggleActions: "play none none none" },
				},
			);
		});
	}

	function initTrustReveal() {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

		const trust = document.querySelector<HTMLElement>(".productos__trust");
		if (!trust) return;

		const items = trust.querySelectorAll<HTMLElement>(".productos__trust-item");
		if (!items.length) return;

		gsap.set(items, { opacity: 0, y: 20 });

		gsap.to(items, {
			opacity: 1,
			y: 0,
			duration: 0.5,
			ease: "power3.out",
			stagger: 0.08,
			scrollTrigger: { trigger: trust, start: "top 88%", toggleActions: "play none none none" },
		});
	}

	function initProductosAnimations() {
		initIntroReveal();
		initCardsReveal();
		initTrustReveal();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initProductosAnimations);
	} else {
		initProductosAnimations();
	}
</script>
