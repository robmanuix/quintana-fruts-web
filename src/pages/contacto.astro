---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ContactoIntro from "../components/ContactoIntro.astro";
import Footer from "../components/Footer.astro";
import { translations, getLocale } from "../i18n/translations";

const t = translations[getLocale(Astro.currentLocale)].contacto;
---

<Layout title={t.pageTitle} description={t.pageDescription}>
	<Header variant="on-light" />
	<main>
		<ContactoIntro />
	</main>
	<Footer />
</Layout>
