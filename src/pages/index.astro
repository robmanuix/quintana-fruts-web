---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Nosotros from "../components/Nosotros.astro";
import PorQueElegirnos from "../components/PorQueElegirnos.astro";
import Productos from "../components/Productos.astro";
import Footer from "../components/Footer.astro";
import { translations, getLocale } from "../i18n/translations";

const t = translations[getLocale(Astro.currentLocale)];
---

<Layout title={t.indexPage.title}>
	<Header />
	<main>
		<Hero />
		<Nosotros />
		<PorQueElegirnos />
		<Productos />
	</main>
	<Footer />
</Layout>
